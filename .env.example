FLASK_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# VPSではサービスアカウント認証のVertex AIを使用
USE_VERTEX_AI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# Todo API（VPS側）
# MATOME_TODO_API_TOKEN_SHA256 には、読み取り用クライアントトークンのSHA-256を設定する
# MATOME_TODO_API_WRITE_TOKEN_SHA256 には、完了マーク用（書き込み）クライアントトークンのSHA-256を設定する
# 読み取り用と書き込み用は別のトークンにすること（漏えい時の影響範囲を分けるため）
MATOME_TODO_API_UID=
MATOME_TODO_API_TOKEN_SHA256=
MATOME_TODO_API_WRITE_TOKEN_SHA256=
# GOOGLE_APPLICATION_CREDENTIALSを使わず、サービスアカウントJSON自体を環境変数で渡す場合のみ
FIREBASE_SERVICE_ACCOUNT_JSON=

# scripts/fetch_matome_todos.py・scripts/complete_matome_todo.py を実行するPC側（VPSには平文トークンを置かない）
MATOME_TODO_API_URL=
MATOME_TODO_API_TOKEN=
MATOME_TODO_API_WRITE_TOKEN=

# Firebase Storageバケット（scripts/migrate_to_firestore.py が使用）
# これは秘密情報ではない（プロジェクトを識別するのみ）
FIREBASE_STORAGE_BUCKET=

# Claudeに任せる（持ち主だけ）。claude.ai の routine の APIトリガーで発行する
CLAUDE_AGENT_OWNER_UID=
CLAUDE_ROUTINE_FIRE_URL=
CLAUDE_ROUTINE_FIRE_TOKEN=
# 選べるリポジトリ（routineに入れてあるもの。カンマ区切り・先頭が初期値）
CLAUDE_AGENT_REPOS=
# アプリのリポジトリは別のroutineで動かす（起動が遅いため）。3つそろうと選べる
CLAUDE_ROUTINE_APPS_FIRE_URL=
CLAUDE_ROUTINE_APPS_FIRE_TOKEN=
CLAUDE_AGENT_APP_REPOS=
# 返事の受け口。空なら本番のURL
CLAUDE_AGENT_REPORT_URL=
